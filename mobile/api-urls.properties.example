# Copy to api-urls.properties (gitignored) to override BuildConfig defaults.
#
# Dev flavor default is emulator → host (10.0.2.2). For a physical device hitting
# production API, uncomment:
API_BASE_URL_DEV=https://api.furkansogutma.net/api/v1
# API_BASE_URL_STAGING=https://api.furkansogutma.net/api/v1
# API_BASE_URL_PRODUCTION=https://api.furkansogutma.net/api/v1
#
# Wrong (Next.js storefront — returns HTML 404 for /api/v1/*):
# API_BASE_URL_DEV=https://furkansogutma.net/api/v1
