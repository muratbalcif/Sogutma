{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FurkanSoğutma POS",
  "version": "1.0.0",
  "identifier": "net.furkansogutma.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FurkanSoğutma POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1366,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "FurkanSoğutma",
    "category": "Business",
    "shortDescription": "FurkanSoğutma market satış (POS)",
    "longDescription": "FurkanSoğutma Windows POS — kasa satış istemcisi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
