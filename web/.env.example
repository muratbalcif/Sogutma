# Storefront (Next.js) — public API base including /api/v1 (browser / build-time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Canonical site origin (sitemap, robots, Open Graph). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Optional public R2 CDN hostname for next/image remotePatterns
NEXT_PUBLIC_R2_PUBLIC_URL=

# Server-only (RSC / Route Handlers / BFF). In Docker production set to
# http://api:3000/api/v1. Leave unset locally to fall back to NEXT_PUBLIC_*.
# INTERNAL_API_BASE_URL=http://localhost:3000/api/v1

# Optional Playwright override (local e2e only)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3002
