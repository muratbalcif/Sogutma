NODE_ENV=development
PORT=3000

# Local docker-compose credentials (never use these in production)
POSTGRES_DB=furkansogutma
POSTGRES_USER=furkansogutma
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5432
REDIS_PASSWORD=changeme-local-redis
REDIS_PORT=6379
# If host 5432/6379 are taken, set POSTGRES_PORT/REDIS_PORT to the compose
# published ports and keep DATABASE_URL/REDIS_URL in sync. Do not hardcode
# alternate ports in tests — E2E reads these env vars / compose port.

DATABASE_URL=postgresql://furkansogutma:changeme-local-only@localhost:5432/furkansogutma
REDIS_URL=redis://:changeme-local-redis@localhost:6379

JWT_ACCESS_SECRET=dev-access-secret-min-16-chars
JWT_REFRESH_SECRET=dev-refresh-secret-min-16-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Optional development seed (never commit real credentials)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional test-only admin seeds (never production credentials)
E2E_PRODUCT_MANAGER_EMAIL=
E2E_PRODUCT_MANAGER_PASSWORD=
E2E_ACCOUNTING_EMAIL=
E2E_ACCOUNTING_PASSWORD=

# Firebase / FCM (optional — API starts without these in development)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated browser origins allowed to call the API (admin + web)
# Required in production — never use *
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Public site config (footer / bank transfer display)
SITE_NAME=FurkanSoğutma
SITE_SUPPORT_EMAIL=info@furkansogutma.com
SITE_SUPPORT_PHONE=+90 324 000 00 00
SITE_ADDRESS=Mersin, Türkiye
SITE_PRIVACY_URL=/gizlilik
SITE_KVKK_URL=/kvkk
SITE_TERMS_URL=/kullanim-kosullari
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_ACCOUNT_NAME=

# Cloudflare R2 (optional in development)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_MAX_UPLOAD_BYTES=5242880
R2_PRESIGN_TTL_SECONDS=300

MAX_IMPORT_ROWS=5000
IMPORT_BATCH_SIZE=100
BACKUP_RETENTION_DAYS=14
BUSINESS_TIMEZONE=Europe/Istanbul
