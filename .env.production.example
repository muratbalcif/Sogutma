# Copy to `.env.production` and fill real secrets. NEVER commit `.env.production`.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   docker compose --env-file .env.production -f docker-compose.production.yml config
#
# JWT_* secrets must be at least 32 characters (API production validation).
# DATABASE_URL / REDIS_URL are set by docker-compose.production.yml (do not set host URLs here).

NODE_ENV=production
PORT=3000

POSTGRES_DB=furkansogutma
POSTGRES_USER=furkansogutma
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

JWT_ACCESS_SECRET=REPLACE_WITH_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_REFRESH_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

CORS_ORIGINS=https://www.furkansogutma.net,https://admin.furkansogutma.net

SITE_NAME=FurkanSoğutma
SITE_SUPPORT_EMAIL=
SITE_SUPPORT_PHONE=
SITE_ADDRESS=Mersin, Türkiye
SITE_PRIVACY_URL=/gizlilik
SITE_KVKK_URL=/kvkk
SITE_TERMS_URL=/kullanim-kosullari

BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_ACCOUNT_NAME=
PAYMENT_EXPIRY_HOURS=24

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=furkansogutma-prod
R2_PUBLIC_URL=https://media.furkansogutma.net
R2_MAX_UPLOAD_BYTES=5242880
R2_PRESIGN_TTL_SECONDS=300

RESEND_API_KEY=
EMAIL_FROM=

BUSINESS_TIMEZONE=Europe/Istanbul

KOLAYBI_API_BASE_URL=
KOLAYBI_API_KEY=
KOLAYBI_CHANNEL=
KOLAYBI_SANDBOX=true

# Next.js build-time public URLs (compose build args — not secrets)
NEXT_PUBLIC_API_BASE_URL=https://api.furkansogutma.net/api/v1
NEXT_PUBLIC_SITE_URL=https://www.furkansogutma.net
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.furkansogutma.net

# Web SSR/BFF → API over Docker network (runtime env on web service; not a secret)
# Compose defaults to http://api:3000/api/v1 if unset.
INTERNAL_API_BASE_URL=http://api:3000/api/v1
