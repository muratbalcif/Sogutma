# Copy to .env.production and fill secrets. Never commit .env.production.
# Used by: docker compose -f docker-compose.production.yml --env-file .env.production

NODE_ENV=production

# Postgres (internal compose service — no host publish)
POSTGRES_DB=furkansogutma
POSTGRES_USER=furkansogutma
POSTGRES_PASSWORD=change-me-strong-postgres-password

# Redis AUTH (internal compose service — no host publish)
REDIS_PASSWORD=change-me-strong-redis-password

# API (DATABASE_URL / REDIS_URL are set by compose to postgres/redis service DNS)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGINS=https://furkansogutma.com,https://admin.furkansogutma.com
BUSINESS_TIMEZONE=Europe/Istanbul

# Optional API integrations (leave empty if unused)
ADMIN_EMAIL=
ADMIN_PASSWORD=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
KOLAYBI_API_BASE_URL=
KOLAYBI_API_KEY=
KOLAYBI_CHANNEL=
KOLAYBI_SANDBOX=false

# Web/Admin build-time public URLs (baked into Next images — not secrets)
NEXT_PUBLIC_API_BASE_URL=https://api.furkansogutma.com/api/v1
NEXT_PUBLIC_SITE_URL=https://furkansogutma.com
NEXT_PUBLIC_R2_PUBLIC_URL=
